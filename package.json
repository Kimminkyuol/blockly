{
  "name": "blockly-java",
  "version": "7.20211209.4",
  "description": "Blockly fork with Java code generator for Minecraft Paper API (used by Plocky)",
  "keywords": ["blockly", "minecraft", "java", "plocky"],
  "repository": {
    "type": "git",
    "url": "https://github.com/kimminkyuol/blockly.git"
  },
  "homepage": "https://github.com/kimminkyuol/plocky",
  "author": {
    "name": "Neil Fraser (original)"
  },
  "scripts": {
    "build": "gulp build",
    "build-debug": "gulp build --verbose --debug",
    "build-strict": "gulp build --verbose --strict",
    "build:compiled": "gulp buildCompiled",
    "build:langfiles": "gulp buildLangfiles",
    "clean": "gulp clean",
    "format": "gulp clangFormat",
    "start": "http-server ./ -o /demos/plocky/index.html -c-1",
    "playground": "http-server ./ -o /demos/plocky/index.html -c-1",
    "test": "tests/run_all_tests.sh",
    "typings": "gulp typings"
  },
  "main": "./index.js",
  "umd": "./blockly.min.js",
  "unpkg": "./blockly.min.js",
  "types": "./index.d.ts",
  "browser": {
    "./node.js": "./browser.js",
    "./core.js": "./core-browser.js",
    "./blockly-node.js": "./blockly.js"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@blockly/block-test": "^2.0.1",
    "@blockly/dev-tools": "^3.0.1",
    "@blockly/theme-modern": "^2.1.25",
    "chai": "^4.2.0",
    "clang-format": "^1.6.0",
    "closure-calculate-chunks": "^3.0.2",
    "concurrently": "^6.0.0",
    "google-closure-compiler": "^20211107.0.0",
    "google-closure-deps": "^20211107.0.0",
    "gulp": "^4.0.2",
    "gulp-clang-format": "^1.0.27",
    "gulp-concat": "^2.6.1",
    "gulp-insert": "^0.5.0",
    "gulp-rename": "^2.0.0",
    "gulp-replace": "^1.0.0",
    "gulp-series": "^1.0.2",
    "gulp-shell": "^0.8.0",
    "gulp-sourcemaps": "^3.0.0",
    "gulp-umd": "^2.0.0",
    "http-server": "^14.1.1",
    "js-green-licenses": "^3.0.0",
    "mocha": "^9.1.1",
    "readline-sync": "^1.4.10",
    "rimraf": "^3.0.2",
    "through2": "^4.0.2",
    "typescript": "^4.3.2",
    "webdriverio": "^7.0.3",
    "yargs": "^17.2.1"
  },
  "dependencies": {
    "jsdom": "15.2.1"
  }
}
